# ---------------------------------------------------------------------------
# Discord — https://discord.com/developers/applications
# ---------------------------------------------------------------------------
# Bot > Token
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_CLIENT_ID=

# Onde registrar os comandos de barra.
#   - Com um ID: registro instantaneo, mas SO nesse servidor. Bom para testar.
#   - Vazio: registro global, funciona em todo servidor que adicionar o bot.
#     Demora ate 1h para aparecer. E o que voce quer se outras pessoas vao usar.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Spotify — OPCIONAL
# ---------------------------------------------------------------------------
# Nada aqui e necessario para o bot funcionar. Qualquer pessoa usa o bot apenas
# conectando o Spotify a conta do Discord (Conexoes > Spotify) — e dai que vem a
# leitura, sem login nenhum.
#
# Preencher esta secao liga a Web API para UMA conta: a de OWNER_USER_ID. Essa
# pessoa ganha espelhamento de pausa e prefetch (musica entra instantaneamente).
# Nao da para estender isso a todo mundo: o app do Spotify em modo de
# desenvolvimento aceita no maximo 25 usuarios, cadastrados um a um no painel.
#
# Seu ID de usuario no Discord. So faz sentido junto com as credenciais abaixo.
OWNER_USER_ID=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Cadastre exatamente esta URI no app do Spotify (loopback obrigatorio, o
# Spotify nao aceita mais "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Gerado por: npm run login:spotify
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Comportamento
# ---------------------------------------------------------------------------
# Intervalo de polling da Web API, em ms. So se aplica a quem tem a API ligada.
POLL_INTERVAL_MS=3000
# follow = interrompe e toca a musica nova na hora
# queue  = enfileira e toca quando a atual acabar
DEFAULT_MODE=follow
# true = comeca a tocar no mesmo ponto em que seu Spotify esta
SYNC_POSITION=true
# true = publica o cartao "Reproduzindo agora" no canal onde /vincular foi usado,
# a cada troca de musica. O cartao anterior e apagado para nao encher o canal.
ANNOUNCE_TRACKS=true
# debug | info | warn | error
LOG_LEVEL=info
