# ---------------------------------------------------------------------------
# Discord — https://discord.com/developers/applications
# ---------------------------------------------------------------------------
# Bot > Token
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_CLIENT_ID=

# Onde registrar os comandos de barra.
#   - Com um ID: registro instantaneo, mas SO nesse servidor. Bom para testar.
#   - Vazio: registro global, funciona em todo servidor que adicionar o bot.
#     Demora ate 1h para aparecer. E o que voce quer se outras pessoas vao usar.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Spotify — OPCIONAL
# ---------------------------------------------------------------------------
# Nada aqui e necessario para o bot funcionar. Qualquer pessoa usa o bot apenas
# conectando o Spotify a conta do Discord (Conexoes > Spotify) — e dai que vem a
# leitura, sem login nenhum.
#
# Preencher esta secao liga a Web API para UMA conta: a de OWNER_USER_ID. Essa
# pessoa ganha espelhamento de pausa e prefetch (musica entra instantaneamente).
# Nao da para estender isso a todo mundo: o app do Spotify em modo de
# desenvolvimento aceita no maximo 25 usuarios, cadastrados um a um no painel.
#
# Seu ID de usuario no Discord. So faz sentido junto com as credenciais abaixo.
OWNER_USER_ID=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Cadastre exatamente esta URI no app do Spotify (loopback obrigatorio, o
# Spotify nao aceita mais "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Gerado por: npm run login:spotify
SPOTIFY_REFRESH_TOKEN=

# So para deixar OUTROS streamers conectarem o proprio Spotify (/conectar-spotify).
# E a URL publica da pagina web/spotify-callback.html hospedada (ex. GitHub Pages).
# Cadastre ela tambem como Redirect URI no app do Spotify. Deixe vazio se so voce
# usa o modo Spotify. Veja o README, secao "Cada streamer com o proprio Spotify".
SPOTIFY_USER_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Comportamento
# ---------------------------------------------------------------------------
# Intervalo de polling da Web API, em ms. So se aplica a quem tem a API ligada.
POLL_INTERVAL_MS=3000
# follow = interrompe e toca a musica nova na hora
# queue  = enfileira e toca quando a atual acabar
DEFAULT_MODE=follow
# true = comeca a tocar no mesmo ponto em que seu Spotify esta
SYNC_POSITION=true
# true = publica o cartao "Reproduzindo agora" no canal onde /vincular foi usado,
# a cada troca de musica. O cartao anterior e apagado para nao encher o canal.
ANNOUNCE_TRACKS=true

# Quantos servidores podem estar tocando ao mesmo tempo. Cada sessao custa
# ~128 kbps de upload continuo mais um ffmpeg, entao o teto real costuma ser a
# sua banda de subida, nao a CPU. Passando disso, /vincular responde avisando.
MAX_SESSIONS=10

# Quantas chamadas ao yt-dlp podem rodar em paralelo. Todas saem do mesmo IP:
# sem limite, varias trocas simultaneas viram uma rajada de requisicoes ao
# YouTube e o risco de 429 sobe para todos. Suba so se souber o que esta fazendo.
YTDLP_CONCURRENCY=3

# ---------------------------------------------------------------------------
# TikTok Live (opcional) - pedidos do chat entram na fila via /tiktok
# ---------------------------------------------------------------------------
# Nada aqui e obrigatorio. A TikTok nao tem API oficial: a integracao faz
# scraping da live e depende de um sign server publico. E contra os ToS da
# TikTok e quebra quando eles mudam o protocolo — use por sua conta.
#
# Prefixo que marca um pedido no chat: "!sr musica".
TIKTOK_PREFIX=!sr
# Quantos pedidos cada espectador pode ter na fila ao mesmo tempo.
TIKTOK_MAX_PER_USER=2
# Depois de mandar um presente, por quantos segundos o proximo pedido da pessoa
# entra na frente da fila.
TIKTOK_PRIORITY_WINDOW_S=120
# Chave da EulerStream, so se o sign server gratuito comecar a limitar. Em uso
# leve costuma funcionar sem nada aqui.
TIKTOK_SIGN_API_KEY=

# Caminho para um cookies.txt do YouTube. Deixe vazio em IP residencial.
# Em VPS e nuvem o YouTube costuma exigir "Sign in to confirm you're not a bot",
# e os cookies de uma conta logada sao a saida documentada pelo yt-dlp.
#
# O arquivo E CREDENCIAL: da acesso a conta que o gerou. Use uma conta
# descartavel, nunca a principal, e deixe o arquivo em chmod 600.
YTDLP_COOKIES=
# debug | info | warn | error
LOG_LEVEL=info
